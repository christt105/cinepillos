# Copy to .env and fill in. Nothing here has a usable default.

# Neon Postgres. Create a project at https://neon.tech, then copy both
# connection strings from its dashboard:
# - DATABASE_URL is the pooled connection (PgBouncer, host ends in "-pooler"),
#   used by the running app.
# - DATABASE_URL_UNPOOLED is the direct connection, used by `prisma migrate`
#   because the pooler doesn't support the session features migrations need.
#   Matches the name Vercel's Neon integration provisions automatically.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/cinepillos?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/cinepillos?sslmode=require"

# https://www.themoviedb.org/settings/api (v3 key), used for search and details.
TMDB_API_KEY=""

# Signs the NextAuth session cookies: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public origin of the app, no trailing slash.
NEXTAUTH_URL="http://localhost:6889"

# OAuth client from https://console.cloud.google.com, Credentials screen.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Read by `prisma db seed` to create the first administrator. There is no
# password: this must be the Google account they will sign in with.
SEED_ADMIN_NAME="admin"
SEED_ADMIN_EMAIL=""

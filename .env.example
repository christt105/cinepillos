# Copy to .env and fill in. Nothing here has a usable default.

# SQLite file, relative to prisma/ unless absolute.
# Local development:
DATABASE_URL="file:./dev.db"
# In the container the database lives on the mounted volume instead:
# DATABASE_URL="file:../data/club.db"

# https://www.themoviedb.org/settings/api (v3 key), used for search and details.
TMDB_API_KEY=""

# Signs the NextAuth session cookies: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public origin of the app, no trailing slash.
NEXTAUTH_URL="http://localhost:6889"

# Read by `prisma db seed` to create the first administrator.
SEED_ADMIN_NAME="admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

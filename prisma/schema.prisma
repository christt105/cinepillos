generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  image     String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  activeGroupId String?
  activeGroup   Group? @relation("ActiveGroup", fields: [activeGroupId], references: [id])

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]

  proposals          Proposal[]
  votes              Vote[]
  candidatesProposed MeetingCandidate[]
  invitationsSent    Invitation[]
}

/// Linked OAuth accounts, required by `PrismaAdapter` even under the jwt session strategy.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Unused while `session.strategy` is "jwt", but required by the PrismaAdapter type.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  activeUsers User[]       @relation("ActiveGroup")
  memberships Membership[]
  meetings    Meeting[]
  proposals   Proposal[]
  invitations Invitation[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  role      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

/// A shareable, revocable link an OWNER (or a site admin) can hand out to let
/// someone join their group without an admin creating an account for them.
model Invitation {
  id        String    @id @default(cuid())
  token     String    @unique
  groupId   String
  invitedBy String
  expiresAt DateTime
  maxUses   Int?
  useCount  Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
}

model Film {
  id          String   @id @default(cuid())
  tmdbId      Int      @unique
  title       String
  overview    String
  posterPath  String?
  releaseDate String?
  createdAt   DateTime @default(now())

  proposals         Proposal[]
  meetingCandidates MeetingCandidate[]
}

model Proposal {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  film  Film  @relation(fields: [filmId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId, groupId])
}

model Meeting {
  id             String   @id @default(cuid())
  date           DateTime
  status         String
  selectedFilmId String?
  groupId        String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  candidates MeetingCandidate[]
}

model MeetingCandidate {
  id        String   @id @default(cuid())
  meetingId String
  filmId    String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  film    Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@unique([meetingId, filmId])
}

model Vote {
  id            String   @id @default(cuid())
  candidateId   String
  userId        String
  createdAt     DateTime @default(now())

  candidate MeetingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
}

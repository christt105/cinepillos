generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  password  String?
  image     String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  activeGroupId String?
  activeGroup   Group? @relation("ActiveGroup", fields: [activeGroupId], references: [id])

  memberships Membership[]

  proposals          Proposal[]
  votes              Vote[]
  candidatesProposed MeetingCandidate[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  image     String?
  createdAt DateTime @default(now())

  activeUsers User[]       @relation("ActiveGroup")
  memberships Membership[]
  meetings    Meeting[]
  proposals   Proposal[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  role      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Film {
  id          String   @id @default(cuid())
  tmdbId      Int      @unique
  title       String
  overview    String
  posterPath  String?
  releaseDate String?
  createdAt   DateTime @default(now())

  proposals         Proposal[]
  meetingCandidates MeetingCandidate[]
}

model Proposal {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  film  Film  @relation(fields: [filmId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId, groupId])
}

model Meeting {
  id             String   @id @default(cuid())
  date           DateTime
  status         String
  selectedFilmId String?
  groupId        String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  candidates MeetingCandidate[]
}

model MeetingCandidate {
  id        String   @id @default(cuid())
  meetingId String
  filmId    String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  film    Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@unique([meetingId, filmId])
}

model Vote {
  id            String   @id @default(cuid())
  candidateId   String
  userId        String
  createdAt     DateTime @default(now())

  candidate MeetingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
}

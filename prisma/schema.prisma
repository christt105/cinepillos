generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())

  proposals Proposal[]
  likes     Like[]
  comments  Comment[]
  votes     Vote[]
  wishlist  Wishlist[]
}

model Film {
  id          String   @id @default(cuid())
  tmdbId      Int      @unique
  title       String
  overview    String
  posterPath  String?
  releaseDate String?
  createdAt   DateTime @default(now())

  proposals        Proposal[]
  wishlists        Wishlist[]
  comments         Comment[]
  meetingCandidates MeetingCandidate[]
}

model Proposal {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
  likes Like[]

  @@unique([userId, filmId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  proposalId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([userId, proposalId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
}

model Meeting {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   @default("PLANNING")
  selectedFilmId String?

  candidates MeetingCandidate[]
}

model MeetingCandidate {
  id        String   @id @default(cuid())
  meetingId String
  filmId    String
  userId    String   @default("system")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  film    Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@unique([meetingId, filmId])
}

model Vote {
  id            String   @id @default(cuid())
  candidateId   String
  userId        String
  createdAt     DateTime @default(now())

  candidate MeetingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
}
